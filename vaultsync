def cmd_start(cfg, args):
    name, pair = resolve_pair_arg(cfg, args)
    try:
        log_mark = os.path.getsize(log_path(name))
    except OSError:
        log_mark = 0
    code, out = install_agent(cfg, name, pair)
    if code != 0:
        die("launchctl refused to start the agent:\n%s" % indent(out))
    time.sleep(1.5)
    running, pid = agent_running(name)
    info(color("started ", GREEN) + "background sync for '%s'%s"
         % (name, " (pid %s)" % pid if pid else ""))
    info(DIM + "It syncs on every local change and polls Drive every %ss. "
         "Survives reboots." % pair.get("interval", 120) + RESET)

    # Confirm the agent can actually read the folder. Under macOS privacy
    # protection a background agent can be denied ~/Documents, and a daemon that
    # cannot see your notes is worse than no daemon at all.
    marker = "cannot read the local folder"
    deadline = time.time() + 75
    while time.time() < deadline:
        try:
            with open(log_path(name)) as f:
                f.seek(log_mark)   # only what this daemon has written
                tail = f.read()
        except OSError:
            tail = ""
        if marker in tail:
            print("", file=sys.stderr)
            print(color("blocked: ", RED) + "the background agent is not allowed "
                  "to read %s" % pair["local"], file=sys.stderr)
            print("  macOS privacy protection is denying it. Grant Full Disk "
                  "Access to:", file=sys.stderr)
            print("    %s" % daemon_python(cfg)[0], file=sys.stderr)
            print("  in System Settings > Privacy & Security > Full Disk Access, "
                  "then run: vaultsync start %s" % name, file=sys.stderr)
            print(DIM + "  Syncing is paused meanwhile; nothing is deleted."
                  + RESET, file=sys.stderr)
            return 1
        if "SCAN local=" in tail:
            info(color("verified ", GREEN) + "the agent can read the folder.")
            return 0
        time.sleep(3)
    info(DIM + "(could not confirm the first background sync yet; check "
         "`vaultsync logs %s`)" % name + RESET)
    return 0


def cmd_stop(cfg, args):
    name, _ = resolve_pair_arg(cfg, args)
    running, _ = agent_running(name)
    remove_agent(name)
    if running:
        # The daemon finishes any in-flight sync before exiting.
        for _ in range(60):
            still, _ = agent_running(name)
            if not still:
                break
            time.sleep(1)
    info(color("stopped ", YELLOW) + "background sync for '%s'" % name)
    info(DIM + "Manual syncs still work: vaultsync now %s" % name + RESET)
    return 0


def cmd_remove(cfg, args):
