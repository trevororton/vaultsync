def cmd_uninstall(cfg, args):
    """Stop everything and remove vaultsync's own files.

    Never touches your vault, your Drive, or your rclone config.
    """
    _, opts = split_args(args, {}, {"yes": "yes", "purge": "purge"})
    pairs = sorted(cfg.get("pairs", {}))
    info(color("Uninstall vaultsync", BOLD))
    here = os.path.abspath(__file__)
    info("  stop and remove %d background agent(s)" % len(pairs))
    info("  remove %s" % here)
    if opts.get("purge"):
        info("  delete %s, including your version history" % BASE)
    else:
        info("  keep %s (config, logs, version history)" % BASE)
        info(DIM + "     add --purge to delete that too" + RESET)
    info("")
    info("  your vault, your Google Drive and your rclone config are untouched")
    if sys.stdin.isatty() and not opts.get("yes"):
        if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
            return 1
    for name in pairs:
        remove_agent(name)
        info("  stopped %s" % name)
    for candidate in (here, os.path.realpath(here),
                      os.path.join(BIN_DIR, "vaultsync")):
        try:
            if os.path.exists(candidate) and BASE not in candidate:
                os.unlink(candidate)
                info("  removed %s" % candidate)
                break
        except OSError as exc:
            info(color("  could not remove %s: %s" % (candidate, exc), YELLOW))
    if opts.get("purge"):
        shutil.rmtree(BASE, ignore_errors=True)
        info("  deleted %s" % BASE)
    info("")
    info(color("Done.", GREEN) + " If you installed with Homebrew, also run:  "
         "brew uninstall vaultsync")
    return 0


def cmd_logs(cfg, args):
    positional, opts = split_args(
        args, {"n": "lines", "lines": "lines"}, {"f": "follow", "follow": "follow"})
    name, _ = resolve_pair_arg(cfg, positional)
    n = int(opts.get("lines", 60))
    follow = bool(opts.get("follow"))
    path = log_path(name)
    if not os.path.exists(path):
        info("no log yet for '%s'" % name)
        return 0
    if follow:
        os.execvp("tail", ["tail", "-n", str(n), "-f", path])
    with open(path) as f:
        lines = f.readlines()
    sys.stdout.write("".join(lines[-n:]))
    return 0


# ---------------------------------------------------------------- history


def history_runs(name):
    root = os.path.join(HISTORY_DIR, name)
    if not os.path.isdir(root):
        return []
    return sorted(d for d in os.listdir(root)
                  if os.path.isdir(os.path.join(root, d)) and d[0].isdigit())


def archived_files(name, stamp):
    """Yield (relpath_in_archive, absolute_path, restore_relpath)."""
    root = os.path.join(HISTORY_DIR, name, stamp)
    for kind in ("local", "conflicts"):
        base = os.path.join(root, kind)
        if not os.path.isdir(base):
            continue
        for dirpath, _, files in os.walk(base):
            for fn in files:
                abs_path = os.path.join(dirpath, fn)
                rel = os.path.relpath(abs_path, base)
                restore = rel
                if kind == "conflicts":
                    restore = re.sub(re.escape(CONFLICT_SUFFIX) + r"\d*", "", rel)
                yield (os.path.join(kind, rel), abs_path, restore)


def cmd_history(cfg, args):
    positional, opts = split_args(args, {"file": "file", "f": "file"})
    grep = opts["file"].lower() if opts.get("file") else None
    name, pair = resolve_pair_arg(cfg, positional)
    runs = history_runs(name)
    if not runs:
        info("No archived versions for '%s' yet." % name)
        info(DIM + "Versions land here when a sync overwrites or deletes a file."
             + RESET)
        return 0

    info(color("Version history for '%s'" % name, BOLD))
    info(DIM + "  archive: %s" % os.path.join(HISTORY_DIR, name) + RESET)
    shown = 0
    for stamp in reversed(runs):
        entries = [e for e in archived_files(name, stamp)]
        if grep:
            entries = [e for e in entries if grep in e[2].lower()]
        if not entries:
            continue
        info("")
        info("  %s  %s" % (color(stamp, BOLD), DIM + "(%d file%s)"
                           % (len(entries), "" if len(entries) == 1 else "s") + RESET))
        for archive_rel, abs_path, restore_rel in entries[:25]:
            kind = "conflict" if archive_rel.startswith("conflicts") else "replaced"
            size = os.path.getsize(abs_path)
            info("    %-9s %s %s" % (kind, restore_rel,
                                     DIM + "(%s)" % human(size) + RESET))
        if len(entries) > 25:
            info("    %s… and %d more" % (DIM, len(entries) - 25) + RESET)
        shown += 1
    if not shown:
        info("  nothing matching %r" % grep)
        return 0
    info("")
    info(DIM + "  restore:  vaultsync restore %s <timestamp> <path>" % name + RESET)
    return 0


def cmd_restore(cfg, args):
    positional = [a for a in args if not a.startswith("-")]
    if len(positional) < 3:
        die("usage: vaultsync restore <pair> <timestamp> <path/in/folder> [--force]")
    name, pair = get_pair(cfg, positional[0])
    stamp, wanted = positional[1], positional[2]

    runs = history_runs(name)
    stamps = [s for s in runs if s == stamp] or [s for s in runs if s.startswith(stamp)]
    if not stamps:
        die("no archived run matching '%s' (see: vaultsync history %s)" % (stamp, name))
    stamp = stamps[-1]

    matches = [e for e in archived_files(name, stamp)
               if e[2] == wanted or e[2].endswith("/" + wanted)
               or os.path.basename(e[2]) == wanted]
    if not matches:
        die("'%s' is not in run %s (see: vaultsync history %s --file %s)"
            % (wanted, stamp, name, os.path.basename(wanted)))
    if len(matches) > 1:
        info("Several archived files match — name one exactly:")
        for _, _, restore_rel in matches:
            info("  " + restore_rel)
        return 1

    _, src, restore_rel = matches[0]
    dest = os.path.join(pair["local"], restore_rel)
    if os.path.exists(dest):
        if "--force" not in args:
            info("This will replace the current file at:")
            info("  %s" % dest)
            info(DIM + "  (its present contents are archived first, so the swap "
                 "is reversible)" + RESET)
            if sys.stdin.isatty():
                if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
                    return 1
        # Archive what is being replaced, so a restore is itself undoable.
        stash_stamp = datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
        stash = os.path.join(history_run_dir(name, stash_stamp), "local", restore_rel)
        os.makedirs(os.path.dirname(stash), exist_ok=True)
        shutil.copy2(dest, stash)
        info(DIM + "  previous contents archived as %s" % stash_stamp + RESET)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    shutil.copy2(src, dest)
    os.utime(dest, None)  # make it newest so it wins the next sync
    info(color("restored ", GREEN) + restore_rel)
    info("  from %s → %s" % (stamp, dest))
    info(DIM + "  Timestamp bumped to now, so the next sync pushes it to Drive."
         + RESET)
    log_event(name, "RESTORE %s from %s" % (restore_rel, stamp))
    return 0


def cmd_prune(cfg, args):
    _, opts = split_args(args, {"days": "days", "d": "days"})
    days = int(opts.get("days", cfg.get("history_days", 30)))
    cutoff = datetime.now() - timedelta(days=days)
    removed = 0
    for name in sorted(cfg["pairs"]) or os.listdir(HISTORY_DIR):
        for stamp in history_runs(name):
            try:
                when = datetime.strptime(stamp, "%Y-%m-%dT%H-%M-%S")
            except ValueError:
                continue
            if when < cutoff:
                shutil.rmtree(os.path.join(HISTORY_DIR, name, stamp),
                              ignore_errors=True)
                removed += 1
    info("Pruned %d archived run(s) older than %d days." % (removed, days))
    if cfg["pairs"]:
        code, out = run_rclone(cfg, [
            "delete", "--min-age", "%dd" % days, "--rmdirs",
            "%s:%s" % (cfg["remote"], cfg["remote_history_base"]),
        ])
        if code == 0:
            info("Pruned the Drive-side archive too.")
    return 0


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return "%.0f %s" % (n, unit) if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024.0



# ---------------------------------------------------------------- diagnostics


def probe_background_access(cfg, path, timeout=45):
    """Can a launchd agent actually read `path`?

    macOS privacy protection can deny a background agent access to ~/Documents
    while the same code works fine in a terminal. That failure is silent — the
    folder simply looks empty — so it is worth testing for directly rather than
    discovering it later.

    Returns True, False, or None if the probe could not be run.
    """
    interpreter, _ = daemon_python(cfg)
    label = LABEL_PREFIX + ".probe"
    result = os.path.join(BASE, "probe-result.txt")
    script = os.path.join(BASE, "probe.py")
    plist = os.path.join(AGENTS_DIR, label + ".plist")
    ensure_dirs()
    for stale in (result, script):
        try:
            os.unlink(stale)
        except OSError:
            pass
    with open(script, "w") as f:
        f.write("import os, sys\n"
                "try:\n"
                "    n = len(os.listdir(sys.argv[1]))\n"
                "    out = 'OK %d' % n\n"
                "except Exception as exc:\n"
                "    out = 'DENIED %s' % exc\n"
                "open(sys.argv[2], 'w').write(out)\n")
    try:
        os.makedirs(AGENTS_DIR, exist_ok=True)
        with open(plist, "wb") as f:
            plistlib.dump({
                "Label": label,
                "ProgramArguments": [interpreter, script, path, result],
                "RunAtLoad": True,
            }, f)
        domain = "gui/%d" % os.getuid()
        launchctl("bootout", "%s/%s" % (domain, label))
        code, _ = launchctl("bootstrap", domain, plist)
        if code != 0:
            return None
        deadline = time.time() + timeout
        while time.time() < deadline:
            if os.path.exists(result):
                with open(result) as f:
                    return f.read().startswith("OK")
            time.sleep(1)
        return None
    finally:
        launchctl("bootout", "gui/%d/%s" % (os.getuid(), label))
        for stale in (plist, script, result):
            try:
                os.unlink(stale)
            except OSError:
                pass


def check(ok, label, detail=""):
    mark = color("OK  ", GREEN) if ok else color("--  ", YELLOW)
    info("  %s%s" % (mark, label))
    if detail:
        info("      " + DIM + detail + RESET)


def cmd_doctor(cfg, args):
    """Check everything vaultsync needs, and say plainly what is missing."""
    info(color("vaultsync %s — checkup" % __version__, BOLD))
    info("")
    problems = []

    rclone = find_binary(cfg, "rclone", "rclone")
    if rclone:
        _, lines, _ = rclone_lines(cfg, ["version"])
        check(True, "rclone", (lines[0] if lines else rclone))
    else:
        problems.append("brew install rclone")
        check(False, "rclone is missing", "needed for all syncing")

    watcher = find_binary(cfg, "fswatch", "fswatch")
    check(bool(watcher), "fswatch" if watcher else "fswatch is missing",
          "instant reaction to local edits"
          if watcher else "optional; without it, local edits wait for the poll")
    if not watcher:
        problems.append("brew install fswatch")

    interpreter, trusted = daemon_python(cfg)
    if trusted:
        check(True, "background interpreter", interpreter)
    else:
        check(False, "only Apple's python3 is available",
              "macOS blocks it from reading ~/Documents in the background")
        problems.append("brew install python@3.13")

    where = os.path.dirname(os.path.abspath(__file__))
    on_path = any(os.path.realpath(d) == os.path.realpath(where)
                  for d in os.environ.get("PATH", "").split(":") if d)
    check(on_path, "vaultsync is on your PATH" if on_path
          else "%s is not on your PATH" % where,
          where if on_path else 'add:  export PATH="%s:$PATH"' % where)

    # Google Drive
    remote = cfg.get("remote", "gdrive")
    remotes = []
    if rclone:
        _, lines, _ = rclone_lines(cfg, ["listremotes"])
        remotes = [r.rstrip(":") for r in lines]
    if remote in remotes:
        code, lines, err = rclone_lines(cfg, ["about", remote + ":"])
        if code == 0:
            check(True, "Google Drive connected (%s:)" % remote,
                  "; ".join(lines[:2]))
        else:
            check(False, "Google Drive remote '%s:' is not responding" % remote,
                  summarize_error(err).splitlines()[-1] if err else "")
            problems.append("vaultsync setup")
        try:
            drive_token(cfg)
            check(True, "Google Docs mode available",
                  "this remote has its own API client")
        except DriveError as exc:
            check(False, "Google Docs mode unavailable", str(exc))
            info("      " + DIM + "see docs/google-oauth.md, then: vaultsync setup"
                 + RESET)
    else:
        check(False, "Google Drive is not connected yet")
        problems.append("vaultsync setup")

    vaults = detect_vaults()
    root = cfg.get("vault_root") or ""
    if root:
        check(True, "default vault", root)
    elif vaults:
        check(False, "no default vault chosen", "%d found" % len(vaults))
        info("      " + DIM + "vaultsync vault %s" % vaults[0] + RESET)
    else:
        check(False, "no Obsidian vault found",
              "you can still sync any folder by full path")

    # The failure worth testing for directly.
    target = root or (cfg["pairs"] and
                      list(cfg["pairs"].values())[0].get("local")) or ""
    if target and os.path.isdir(target):
        info("")
        info("  " + DIM + "testing whether a background agent can read your "
             "vault..." + RESET)
        allowed = probe_background_access(cfg, target)
        if allowed is True:
            check(True, "background access to your vault")
        elif allowed is False:
            check(False, "macOS is blocking background access to your vault")
            info("      Grant Full Disk Access to:")
            info("        %s" % interpreter)
            info("      " + DIM + "System Settings > Privacy & Security > "
                 "Full Disk Access" + RESET)
            problems.append("grant Full Disk Access to " + interpreter)
        else:
            check(False, "could not test background access",
                  "run `vaultsync doctor` again, or check `vaultsync logs`")

    info("")
    if problems:
        info(color("To fix:", BOLD))
        for item in dict.fromkeys(problems):
            info("    %s" % item)
        return 1
    info(color("Everything checks out.", GREEN))
    if not cfg["pairs"]:
        info(DIM + 'Mirror a folder with:  vaultsync add "<folder>"' + RESET)
    return 0

# ---------------------------------------------------------------- misc


def split_args(args, value_opts=(), flags=()):
    """Split argv into (positional, options) so option values are never mistaken
    for a pair name."""
    positional, opts = [], {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("-"):
            key = a.lstrip("-")
            if key in value_opts and i + 1 < len(args):
                opts[value_opts[key]] = args[i + 1]
                i += 2
                continue
            if key in flags:
                opts[flags[key]] = True
            i += 1
            continue
        positional.append(a)
        i += 1
    return positional, opts


def parse_opts(args, spec, flags=()):
    out = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            key = a[2:]
            if key in flags:
                out[key] = True
                i += 1
                continue
            if key in spec and i + 1 < len(args):
                out[key] = spec[key](args[i + 1])
                i += 2
                continue
        i += 1
    return out


HELP = """\
{bold}vaultsync{reset} — keep a vault folder and Google Drive mirrored, both ways.

  {bold}Getting started{reset}
    vaultsync setup                  guided first-time setup
    vaultsync add "Project Notes"    mirror a folder and start syncing
        --mode docs                  sync notes as native Google Docs
        --remote PATH                Drive destination (default VaultSync/<Folder>)
        --interval SECONDS           how often to poll Drive (default 120)
        --no-start                   configure without starting the daemon
    vaultsync mode <pair> docs       convert an existing folder to Google Docs
    vaultsync adopt [pair]           turn stray plain .md in Drive into Docs

  {bold}Day to day{reset}
    vaultsync list                   folders being mirrored, and their state
    vaultsync status [pair]          detail for one folder
    vaultsync now [pair]             sync immediately  (-n for a dry run)
    vaultsync check [pair]           show what a sync would change
    vaultsync logs [pair] [-n 60]    recent activity  (-f to follow)

  {bold}Background sync{reset}
    vaultsync start [pair]           run continuously, and after reboot
    vaultsync stop  [pair]           stop the background daemon

  {bold}Version history{reset}
    vaultsync history [pair]         every version that was replaced or discarded
        --file NAME                  only versions of a given file
    vaultsync restore <pair> <timestamp> <path>
    vaultsync prune [--days 30]      delete archives older than N days

  {bold}Health{reset}
    vaultsync doctor                 check tools, auth and background access
    vaultsync vault [path]           show or set your default vault
    vaultsync version

  {bold}Housekeeping{reset}
    vaultsync resync [pair]          rebuild the baseline (newer copy wins)
    vaultsync remove <pair>          stop mirroring  (--delete-drive to also
                                     delete the Drive copy)
    vaultsync uninstall              remove vaultsync itself (--purge for state)

  {bold}How conflicts are handled{reset}
    If a file changed on both sides, the newer timestamp wins so folders stay
    clean. The version that lost, and anything a sync overwrote or deleted, is
    archived to ~/.vaultsync/history — browse it with `vaultsync history`.

    Exception, in docs mode: when a Doc is {bold}shared{reset} with anyone, both versions
    are kept instead, because discarding one would throw away a collaborator's
    work. The Doc's version is written beside the note for you to merge.
    Sharing is read from Drive, so there is nothing to label by hand.

  {bold}Google Docs mode{reset}
    Each note lives in Drive as a real Google Doc you can share and comment on,
    and edits made there flow back into the vault. Docs are addressed by file ID
    and updated in place, so comments, sharing and Drive revision history all
    survive, and no duplicate Doc is ever created.

    Non-markdown files in the folder (images, PDFs) keep syncing as ordinary
    files, so the mirror stays complete.

    Google's markdown export is never byte-identical to the markdown that made
    the Doc: it escapes punctuation, adds trailing hard breaks, and rewrites
    table rules. Those are cleaned up on the way in. One kind of drift cannot be
    undone — a soft line break inside a paragraph becomes a space — so vaultsync
    only rewrites a note when the Doc genuinely changed, never as a side effect
    of its own writes.

