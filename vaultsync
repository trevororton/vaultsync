def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        return cmd_help(None, [])
    cmd = argv[0]
    if cmd not in COMMANDS:
        die("unknown command '%s'  (try: vaultsync help)" % cmd)
    cfg = load_config()
    return COMMANDS[cmd](cfg, argv[1:]) or 0


if __name__ == "__main__":
