def cmd_now(cfg, args):
    names, opts = split_args(args, {}, {"dry-run": "dry", "n": "dry"})
    dry = bool(opts.get("dry"))
    targets = names or sorted(cfg["pairs"])
    if not targets:
        die("no folders configured. Add one with:  vaultsync add \"<Folder>\"")
    worst = 0
    for raw in targets:
        name, pair = get_pair(cfg, raw)
        try:
            with Lock(name, wait=120):
                code, _ = sync_once(cfg, name, pair, dry_run=dry)
        except RuntimeError as exc:
            print(color("skipped ", YELLOW) + "%s: %s" % (name, exc), file=sys.stderr)
            code = 1
        worst = max(worst, code)
    return worst


def cmd_check(cfg, args):
    name, pair = resolve_pair_arg(cfg, args)
    info("Dry run — no files will be changed.")
