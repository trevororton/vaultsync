def cmd_resync(cfg, args):
    name, pair = resolve_pair_arg(cfg, args)
    info("Re-establishing the baseline for '%s'." % name)
    info(DIM + "Files present on both sides are reconciled by timestamp; the "
         "newer copy wins." + RESET)
    if sys.stdin.isatty() and "--yes" not in args:
        if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
            return 1
