                                   else "plain files"))
        info("  daemon       %s" % ("running (pid %s)" % pid if running
                                    else color("not running", YELLOW)))
        info("  poll         every %ss" % pair.get("interval", 120))
        info("  baseline     %s" % ("established" if state.get("baselined")
                                    else color("not yet synced", YELLOW)))
