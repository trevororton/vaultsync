def cmd_mode(cfg, args):
    positional, _ = split_args(args, {}, {"yes": "yes"})
    if len(positional) < 2:
        die("usage: vaultsync mode <pair> docs|files")
    name, pair = get_pair(cfg, positional[0])
    target = positional[1]
    if target not in ("files", "docs"):
        die("mode must be 'docs' or 'files'")
    current = pair.get("mode", "files")
    if current == target:
        info("'%s' is already in %s mode." % (name, target))
        return 0

    if target == "files":
        info(color("Switching '%s' back to plain files." % name, YELLOW))
        info("Any Google Docs in the Drive folder will stop syncing and be "
             "left untouched.")
        if sys.stdin.isatty() and "--yes" not in args:
            if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
                return 1
        pair["mode"] = "files"
        save_config(cfg)
        read_state(name) and write_state(name, dict(read_state(name),
                                                    baselined=False))
        info("Done. Next sync re-establishes the plain-file baseline.")
        return 0

    # files -> docs
    try:
        remote_docs, strays, remote_plain, _ = scan_remote_docs(cfg, pair)
    except DriveError as exc:
        die(str(exc))
    local = scan_local_md(pair["local"])
    legacy = {r: d for r, d in remote_docs.items() if d["legacy_name"]}
    to_create = [r for r in local if r not in remote_docs]

    info(color("Convert '%s' to native Google Docs" % name, BOLD))
    info("  %d note(s) become Google Docs in %s" % (len(to_create), pair["remote"]))
    if legacy:
        info("  %d existing Doc(s) adopted, and renamed to match their note:"
             % len(legacy))
        for rel in sorted(legacy):
            info("      %s  ->  %s" % (legacy[rel]["name"],
                                       re.sub(r"\.md$", "", os.path.basename(rel))))
    if strays:
        info("  %d plain .md file(s) in Drive retired, since the Doc replaces them"
             % len(strays))
        info(DIM + "      (your local copies are the source and stay untouched; "
             "Drive keeps them in its trash)" + RESET)
    if remote_plain:
        info("  %d non-markdown file(s) keep syncing as ordinary files"
             % len(remote_plain))
    if sys.stdin.isatty() and "--yes" not in args:
        if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
            return 1

    was_running, _ = agent_running(name)
    if was_running:
        cmd_stop(cfg, [name])

    # The engine itself adopts legacy Docs and retires stray .md files, all by
    # file ID, so there is nothing to reorganise by name up front.
    pair["mode"] = "docs"
    save_config(cfg)
    write_docs_state(name, {})
    info("")
    with Lock(name, wait=120):
        code, _ = sync_docs(cfg, name, pair)
    if was_running:
        cmd_start(cfg, [name])
    return code


def cmd_adopt(cfg, args):
